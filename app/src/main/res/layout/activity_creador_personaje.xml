<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".CreadorPersonajeActivity">


    <EditText
        android:id="@+id/editTextNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ems="10"
        android:hint="Nombre del guerrero"
        android:inputType="textPersonName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/spinnerRaza"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="1dp"
        android:entries="@array/razas_tierra_media"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextNombre" />

    <CheckBox
        android:id="@+id/checkBoxSigilo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Sigilo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radioGroup3" />

    <CheckBox
        android:id="@+id/checkBoxCombateEspada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Combate con Espada"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/checkBoxSigilo" />

    <TextView
        android:id="@+id/textViewNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre:"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="33dp" />


    <RadioGroup
        android:id="@+id/radioGroup3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinnerRaza">

        <TextView
            android:id="@+id/textViewFacción"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Facción:" />

        <RadioButton
            android:id="@+id/radioMordor"
            android:layout_width="281dp"
            android:layout_height="53dp"
            android:text="Huestes de Mordor"
            tools:layout_editor_absoluteX="-6dp"
            tools:layout_editor_absoluteY="339dp" />

        <RadioButton
            android:id="@+id/radioComunidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comunidad del Anillo"
            tools:layout_editor_absoluteX="3dp"
            tools:layout_editor_absoluteY="393dp" />

    </RadioGroup>

    <TextView
        android:id="@+id/textViewRaza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Raza:"
        app:layout_constraintBottom_toTopOf="@+id/spinnerRaza"
        tools:layout_editor_absoluteX="4dp" />

    <TextView
        android:id="@+id/textViewHabilidades"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Habilidades especiales"
        app:layout_constraintBottom_toTopOf="@id/checkBoxSigilo"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="135dp"
        android:layout_height="114dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@+id/checkBoxCombateEspada"
        app:srcCompat="@drawable/espada"
        tools:layout_editor_absoluteX="0dp" />


</androidx.constraintlayout.widget.ConstraintLayout>